# Shares datavruti's Supabase project and Google OAuth client.
# Copy values from datavruti/.env.local. Keep `schema=portfolio` on BOTH database URLs:
# it isolates this site's tables from datavruti's. `npm run db:push` refuses to run without it.

# ── Database (datavruti Supabase Postgres, "portfolio" schema) ───────────────
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=portfolio"
DIRECT_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?schema=portfolio"

# ── Images (datavruti's public "blog-images" bucket, under portfolio/) ───────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server-only secret"
SUPABASE_BUCKET="blog-images"

# ── Admin sign-in (same Google OAuth client as datavruti) ────────────────────
NEXTAUTH_URL="http://localhost:3000"            # https://vikramparekh.com in production
NEXTAUTH_SECRET="run: openssl rand -base64 32"  # separate from datavruti's
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Optional: force the canonical site URL. On Vercel this is detected automatically
# from the production domain (switches to vikramparekh.com once that's connected).
NEXT_PUBLIC_SITE_URL=""
